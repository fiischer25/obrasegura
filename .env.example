# Copie este arquivo para .env.local (ou cole estas variáveis no painel da Vercel)
# e preencha os valores. NUNCA coloque o .env.local no git.

# Anthropic (platform.claude.com → API Keys). Começa com sk-ant-
ANTHROPIC_API_KEY=

# Supabase (Project Settings → API Keys)
# URL do projeto, ex.: https://abcdefgh.supabase.co
SUPABASE_URL=
# "Secret key" (sb_secret_...) ou a antiga "service_role". Dá acesso total ao banco: só no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (Fase 2) — developers → Suas integrações → Credenciais
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta do webhook (Fase 2)
MERCADOPAGO_WEBHOOK_SECRET=

# Resend (Fase 2) — resend.com → API Keys. Começa com re_
RESEND_API_KEY=
# Remetente dos e-mails, com domínio verificado no Resend
EMAIL_FROM="Obra Segura <parecer@obrasegura.com.br>"

# Endereço do site, sem barra no final
SITE_URL=http://localhost:3000

# Senha do painel /admin e do modo de teste (/revisar?teste=1). Use 16+ caracteres.
ADMIN_PASSWORD=

# Rastreamento (opcional, Fase 4)
META_PIXEL_ID=
GA4_ID=
